{
  "name": "banquillo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Banquillo: simulador de entrenador de fútbol",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "tsx scripts/generate.ts",
    "import": "tsx scripts/import.ts",
    "verify-db": "tsx scripts/verify-db.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "experiments": "tsx scripts/experiments.ts",
    "real-db": "python3 -I scripts/real/build_fc27.py && tsx scripts/import.ts data/real/import --fill --start 2026-07-01 --name \"Mundo real FC 27 (2026/27)\" --out data/real/world-fc27.json && tsx scripts/real/finalize.ts data/real/world-fc27.json",
    "real-db:download": "bash scripts/real/download.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
